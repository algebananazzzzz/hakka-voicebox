---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Ma Shan Zheng is only used on the homepage, so other pages skip the download. */
  brushFont?: boolean;
}

const {
  title,
  description = '客家话音库：一句一句录下来的客家话。',
  noindex = false,
  brushFont = false,
} = Astro.props;
const families = [
  'EB+Garamond:ital,wght@0,400;0,500;0,600;1,400',
  ...(brushFont ? ['Ma+Shan+Zheng'] : []),
  'Noto+Sans+SC:wght@400;500;700',
  'Noto+Serif+SC:wght@500;700;900',
];
const fontsHref = `https://fonts.googleapis.com/css2?${families.map((f) => `family=${f}`).join('&')}&display=swap`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body>
    <slot />
  </body>
</html>
